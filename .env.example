APP_NAME=SINAGUA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8081
APP_PORT=8081

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Autenticación (M1): bloqueo tras N intentos, minutos de bloqueo, minutos de inactividad
# que expiran el token y vida máxima del token en horas.
AUTH_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_IDLE_MINUTES=30
AUTH_TOKEN_LIFETIME_HOURS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=sinagua
DB_USERNAME=sinagua
# Rol de la API: sin superusuario ni BYPASSRLS (lo crea docker/postgres/init-app-role.sh).
# Cambie las contraseñas en su .env local; nunca las suba al repositorio.
DB_PASSWORD=cambiar-esta-contrasena
# Superusuario "postgres", solo para administración (no lo use en la API).
DB_ROOT_PASSWORD=cambiar-esta-contrasena-root
DB_FORWARD_PORT=5433

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# MinIO: usuario y clave raíz del contenedor (cámbielos en su .env local)
AWS_ACCESS_KEY_ID=sinagua-minio
AWS_SECRET_ACCESS_KEY=cambiar-esta-clave
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=comprobantes
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:9000/comprobantes
AWS_USE_PATH_STYLE_ENDPOINT=true
MINIO_FORWARD_PORT=9000
MINIO_CONSOLE_PORT=9001

VITE_APP_NAME="${APP_NAME}"
